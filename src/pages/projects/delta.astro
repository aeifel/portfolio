  <a class="back-inline" href="/#projects">&larr; board</a>
  <p class="eyebrow">PROJECT</p>
  <h1>Delta</h1>
  <p class="sub">A change intelligence platform</p>
  <div class="stack">
    <ul class="stack-t">
      {DELTA.stack.map((t) => <li>{t}</li>)}
    </ul>
    <a class="repo" href="https://github.com/aeifel/delta" target="_blank" rel="noopener noreferrer"
