  <div class="modal" id="dgModal" hidden>
    <div class="modal-in" role="dialog" aria-modal="true" aria-label="Architecture diagram">
      <button class="modal-close" id="dgClose" type="button" aria-label="Close">&times;</button>
      <div class="modal-scroll" id="dgSlot"></div>
      <p class="modal-cap">Delta &mdash; system architecture</p>
    </div>
  </div>

  <script is:inline>
    (() => {
      // The diagram is moved into the modal rather than copied, so the document
      // never holds two elements carrying the same marker and title ids.
      const frame = document.getElementById('dgFrame');
      const modal = document.getElementById('dgModal');
      const slot = document.getElementById('dgSlot');
      const close = document.getElementById('dgClose');
      if (!frame || !modal) return;
      const svg = frame.querySelector('svg.dg');
      let last = null;

      const open = () => {
        if (!modal.hidden) return;
        last = document.activeElement;
        slot.appendChild(svg);
        modal.hidden = false;
        document.body.style.overflow = 'hidden';
        close.focus();
      };
      const shut = () => {
        if (modal.hidden) return;
        frame.appendChild(svg);
        modal.hidden = true;
        document.body.style.overflow = '';
        if (last) last.focus();
      };
      frame.addEventListener('click', open);
      frame.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); }
      });
      close.addEventListener('click', shut);
      modal.addEventListener('click', (e) => { if (e.target === modal) shut(); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') shut(); });
    })();
  </script>
</Base>
