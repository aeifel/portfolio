---
import Base from '../layouts/Base.astro';
import Bar from '../components/Bar.astro';
import ZoomBar from '../components/ZoomBar.astro';
import { RESUME } from '../data/resume';
---
<Base
  title="Hari Prasath — Resume"
  description="I build and own production systems, working across backend, distributed systems, real-time video and AI/ML pipelines."
  bodyClass="resume-page"
>
  <Bar solid />
  <div class="cvscroll">
  <main class="cvpage">
    <div class="cv-wrap">
      <div class="cv-actions">
        <a class="cv-back" href="/">&larr; back to the board</a>
        <a class="cv-dl" href="/Hari-Prasath-Resume.pdf" download>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.6v8.2m0 0L4.9 6.7M8 9.8l3.1-3.1M2.6 12.1v1.2a1 1 0 0 0 1 1h8.8a1 1 0 0 0 1-1v-1.2"/></svg>
          PDF
        </a>
      </div>

      <header class="cv-top">
        <h1>{RESUME.name}</h1>
      </header>

      <h2>EXPERIENCE</h2>
      <div class="cv-job-h">
        <div><b>{RESUME.job.title}</b></div>
      </div>
      {RESUME.sections.map((s) => (
        <>
          <h3>{s.heading}</h3>
          <ul>{s.bullets.map((b) => <li><b>{b.lead}</b><span set:html={b.rest} /></li>)}</ul>
        </>
      ))}

      <h2>{RESUME.project.heading}</h2>
      <ul>{RESUME.project.bullets.map((b) => <li><b>{b.lead}</b><span set:html={b.rest} /></li>)}</ul>

      <h2>TECHNICAL SKILLS</h2>
      <dl class="cv-skills">
        {RESUME.skills.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}
      </dl>

    </div>
  </main>
  </div>
  <ZoomBar />
</Base>
