---
import Binline from './Binline.astro';
import { LINKS } from '../data/resume';
---
<footer class="foot">
  <div class="socials">
    <a class="soc" href={LINKS.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="3"/>
        <path d="M7.6 10.4v6.2"/><circle cx="7.6" cy="7.6" r=".95" fill="currentColor" stroke="none"/>
        <path d="M11.3 16.6v-6.2M11.3 12.6c0-1.3 1-2.3 2.3-2.3s2.5 1 2.5 2.6v3.7"/>
      </svg><span>linkedin</span>
    </a>
    <a class="soc" href={LINKS.github} target="_blank" rel="noopener" aria-label="GitHub">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M9.3 19.6c-4 1.2-4-2.1-5.6-2.5m11.2 5.1v-3.2a2.8 2.8 0 0 0-.8-2.2c2.6-.3 5.3-1.3 5.3-5.8a4.5 4.5 0 0 0-1.2-3.1 4.2 4.2 0 0 0-.1-3.1s-1-.3-3.3 1.2a11.3 11.3 0 0 0-5.8 0C6.7 4.5 5.7 4.8 5.7 4.8a4.2 4.2 0 0 0-.1 3.1 4.5 4.5 0 0 0-1.2 3.2c0 4.4 2.7 5.4 5.3 5.7a2.8 2.8 0 0 0-.8 2.2V22"/>
      </svg><span>github</span>
    </a>
  </div>
  <a class="up-link" href="#top" id="topLink">↑ back up to the board</a>
  <div class="made">
    <span>Made by</span>
    <Binline text="HP" encoding="bin" class="sig" />
  </div>
</footer>

<script is:inline>
  (() => {
    // Smooth scrolling is requested here rather than set globally on <html>,
    // where it interferes with the browser restoring your position on reload.
    const link = document.getElementById('topLink');
    if (!link) return;
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const smooth = !matchMedia('(prefers-reduced-motion:reduce)').matches;
      scrollTo({ top: 0, behavior: smooth ? 'smooth' : 'auto' });
    });
  })();
</script>
