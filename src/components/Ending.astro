---
import { QUOTES } from '../data/quotes';
import { RESUME } from '../data/resume';
---
<section class="under" id="under">
  <div class="field" id="field" aria-hidden="true"></div>
  <div class="under-grid">
    <div class="under-copy">
      <blockquote class="bq">
        <p class="q" id="quoteText"></p>
        <cite id="quoteWho"></cite>
      </blockquote>
    </div>

    <div class="pawn" aria-hidden="true">
      <span class="rail"></span>
      <pre id="pawn"></pre>
      <span class="rail"></span>
    </div>

    <div class="resume">
      <div class="ds-head"><span>DATASHEET</span><i></i></div>
      {RESUME.datasheet.map((p) => <p>{p}</p>)}
      <a class="ds-btn" href="/resume">View Resume &rarr;</a>
    </div>
  </div>
</section>

<script is:inline define:vars={{ QUOTES }}>
  (() => {
    const q = QUOTES[Math.floor(Math.random() * QUOTES.length)];
    document.getElementById('quoteText').textContent = '“' + q.text + '”';
    document.getElementById('quoteWho').textContent = q.who;

    // head, neck, collar, tapering body, flared foot — half-widths per row
    const PAWN_H = [1,3,4,5,6,6,6,6,5,4,3, 3,3, 9,8, 5,4,4,4,5,5,6,6, 7,7,8,9,10,11,12, 13,13];
    const PW = 27;
    const el = document.getElementById('pawn');
    const rows = () => PAWN_H.map((h) => {
      const w = 2 * h + 1;
      return ' '.repeat((PW - w) / 2) + Array.from({ length: w }, () => (Math.random() > 0.5 ? '1' : '0')).join('');
    }).join('\n');
    el.textContent = rows();
    const reduced = matchMedia('(prefers-reduced-motion:reduce)').matches;
    if (!reduced) setInterval(() => {
      const a = [...el.textContent];
      for (let k = 0; k < 12; k++) {
        const i = Math.floor(Math.random() * a.length);
        if (a[i] === '0' || a[i] === '1') a[i] = Math.random() > 0.5 ? '1' : '0';
      }
      el.textContent = a.join('');
    }, 220);

    const under = document.getElementById('under');
    const reveal = () => {
      const f = document.getElementById('field');
      if (!f.childElementCount) {
        const cols = Math.ceil(innerWidth / 9.2), rws = Math.ceil(innerHeight / 17);
        f.innerHTML = Array.from({ length: rws }, () =>
          `<div style="animation-delay:${(Math.random() * 8).toFixed(1)}s">${
            Array.from({ length: cols }, () => (Math.random() > 0.5 ? '1' : '0')).join('')}</div>`).join('');
      }
      under.classList.add('in');
    };
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && reveal()), { threshold: 0.25 }).observe(under);
    } else reveal();
  })();
</script>
