---
import '../styles/global.css';
interface Props { title: string; description?: string; bodyClass?: string }
const {
  title,
  description = 'I build challenging applications and solve challenging problems.',
  bodyClass = '',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;

// Told to search engines directly, rather than left to be inferred from markup.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Hari Prasath S',
  alternateName: 'Hari Prasath',
  url: Astro.site?.href,
  image: ogImage,
  jobTitle: 'Software Engineer',
  description:
    'Software engineer working across backend systems, distributed infrastructure, real-time video and AI/ML platforms.',
  sameAs: ['https://github.com/aeifel', 'https://www.linkedin.com/in/hariprasathtech'],
  knowsAbout: [
    'Software Engineering', 'Distributed Systems', 'Backend Development',
    'AI Engineering', 'LLM Inference', 'Real-Time Video', 'Python', 'Kubernetes',
  ],
};
---
<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <link rel="canonical" href={canonical} />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Hari Prasath" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Hari Prasath — software engineer" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />
  {/* GitHub Pages cannot set response headers, so the policy goes in a meta
      tag. 'unsafe-inline' is required while the scripts and styles are inline;
      frame-ancestors and nosniff only work as real headers, so they need a
      proxy or a different host. */}
  <meta
    http-equiv="Content-Security-Policy"
    content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; upgrade-insecure-requests"
  />
  <script is:inline>
    // Before first paint: opt into motion only when JS is on and motion is welcome,
    // and restore the stored theme so there is no flash of the wrong palette.
    // Scroll restoration is left on the browser default, so a reload keeps your
    // place without touching the URL.
    if (!matchMedia('(prefers-reduced-motion:reduce)').matches)
      document.documentElement.classList.add('js');
    try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
</head>
<body class={bodyClass}>
  <slot />
  <script is:inline>
    (() => {
      const root = document.documentElement;
      const btn = document.getElementById('themeBtn');
      if (!btn) return;
      const paint = () => { btn.textContent = root.dataset.theme === 'dark' ? '☾ dark' : '☀ light'; };
      paint();
      btn.addEventListener('click', () => {
        root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        paint();
        try { localStorage.setItem('theme', root.dataset.theme); } catch (e) {}
      });
    })();
  </script>
</body>
</html>
